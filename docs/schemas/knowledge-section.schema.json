{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-section.schema.json",
  "title": "Knowledge section (one vector space)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "order", "title", "description", "retrieval", "clarification", "entries"],
  "properties": {
    "contract_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "order": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 10},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {"enum": ["lookup", "procedure", "explain", "rules", "safety", "chat"]},
        "bm25_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 5},
        "min_score": {"type": ["number", "null"]},
        "entity_filters": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true}
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["between_entries", "bank", "fallback"],
      "properties": {
        "between_entries": {"type": "string", "pattern": "\\{label_a\\}[\\s\\S]*\\{label_b\\}"},
        "bank": {"type": "array", "minItems": 2, "maxItems": 10, "items": {"type": "string", "minLength": 5}},
        "slot_questions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 5}},
        "fallback": {"type": "string", "minLength": 10}
      }
    },
    "featured": {"type": "array", "items": {"$ref": "#/$defs/entryId"}, "maxItems": 5},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "entryId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z0-9_]+$"},
    "isoDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "text": {"type": "string", "minLength": 1},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "audience", "examples", "answer", "sources"],
      "properties": {
        "id": {"$ref": "#/$defs/entryId"},
        "label": {"type": "string", "minLength": 3, "maxLength": 80},
        "kind": {"enum": ["fact", "procedure", "explanation", "rule", "safety", "action", "chat"]},
        "audience": {"enum": ["visitor", "staff"]},
        "lang": {"type": "string", "pattern": "^[a-z]{2}$"},
        "examples": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "hard_negatives": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "entities": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "needs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "answer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short"],
          "properties": {
            "short": {"type": "string", "minLength": 10},
            "variants": {"type": "array", "items": {"$ref": "#/$defs/text"}},
            "steps": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}},
            "detail": {"type": ["string", "null"]},
            "reflection": {"type": ["string", "null"]}
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "retrieved_at"],
            "oneOf": [{"required": ["url"]}, {"required": ["document"]}],
            "properties": {
              "label": {"$ref": "#/$defs/text"},
              "url": {"type": "string", "pattern": "^https?://"},
              "document": {"type": "string", "pattern": "^research_notes/uton_guion_2024/[a-z0-9_]+\\.txt$"},
              "retrieved_at": {"$ref": "#/$defs/isoDate"}
            }
          }
        },
        "last_verified": {"$ref": "#/$defs/isoDate"},
        "valid_until": {"oneOf": [{"$ref": "#/$defs/isoDate"}, {"type": "null"}]},
        "related": {"type": "array", "items": {"$ref": "#/$defs/entryId"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "verified_by_uton": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "action"}}}, "then": {"required": ["action"]}},
        {
          "if": {"required": ["verified_by_uton"], "properties": {"verified_by_uton": {"const": true}}},
          "then": {"properties": {"sources": {"items": {"required": ["document"]}}}}
        }
      ]
    }
  }
}
