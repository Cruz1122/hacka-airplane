{"pid": "rules.authorized_stay_duration#p07", "same_facts": true, "caveats_kept": true, "atoms_exact": true, "natural": true, "verdict": "ok"}
{"pid": "rules.authorized_stay_duration#p08", "same_facts": true, "caveats_kept": true, "atoms_exact": true, "natural": true, "verdict": "ok"}
{"pid": "rules.authorized_stay_duration#p09", "same_facts": true, "caveats_kept": true, "atoms_exact": true, "natural": true, "verdict": "fix", "fixed_text": "Respeta el tiempo del permiso: no alargues la caminata, no sumes noches de campamento y sal del parque dentro de ese tiempo, salvo con una autorización nueva del parque. Solo puedes permanecer lo que dice el permiso de ingreso; para más tiempo, pide otra autorización antes.", "note": "Removed filler wording; preserved all required facts."}
