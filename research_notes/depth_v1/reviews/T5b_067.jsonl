{"pid":"preparation.rain_poncho#p01","same_facts":true,"caveats_kept":true,"atoms_exact":true,"natural":true,"verdict":"ok","emergency_ok":true}
{"pid":"preparation.rain_poncho#p02","same_facts":true,"caveats_kept":true,"atoms_exact":true,"natural":true,"verdict":"ok","emergency_ok":true}
{"pid":"preparation.rain_poncho#p03","same_facts":true,"caveats_kept":true,"atoms_exact":true,"natural":true,"verdict":"ok","emergency_ok":true}
